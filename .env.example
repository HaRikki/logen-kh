# ---- required ----
DATABASE_URL=postgresql://user:pass@localhost:5432/logenkhpay
SECRET_KEY=change-me-long-random
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"   (keep it forever: losing it makes stored provider keys unreadable)
FERNET_KEY=
ADMIN_EMAIL=you@example.com
# Pre-created admin login: sign in at /admin/login with this username + password. Password is read only from env (set a long random one).
ADMIN_USERNAME=admin1
ADMIN_PASSWORD=
# ---- URLs (all of these can be changed later in Admin > Settings; nothing is hardcoded) ----
PUBLIC_BASE_URL=https://logen-khpay.onrender.com
API_BASE_URL=
CHECKOUT_BASE_URL=
WEBHOOK_BASE_URL=
ALLOWED_ORIGINS=
# ---- payment provider ----
PROVIDER_BASE_URL=https://khqrpay.site
# REQUIRED for payments to ever become "paid": status-check URL from the khqrpay.site docs. Placeholders: {ref} {order_id} {transaction_id}
PROVIDER_CHECK_URL=
PROVIDER_CHECK_METHOD=GET
RATE_LIMIT_PER_MIN=60
# ---- social login (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ---- email for password reset (optional; without it the reset link is only written to the server log) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
